<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 8-11: nothing of this app is backed up. allowBackup="false" in the manifest already
    turns backup off there; this file says the same explicitly.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
