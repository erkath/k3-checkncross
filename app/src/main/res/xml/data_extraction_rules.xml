<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+: nothing of this app goes to Google's cloud backup.
    Device-to-device transfer (moving to a new phone by cable or locally) is left as Android does it:
    the data goes straight from phone to phone.
    Older Android versions are covered by android:allowBackup="false" in the manifest.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
</data-extraction-rules>
